# Local Ollama mode for MacBook Pro M1 8GB.
LLM_PROVIDER=ollama
MODEL_LOCAL_FILES_ONLY=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=4096

# Optional OpenRouter mode. Uncomment these only if you want remote LLM responses later.
# LLM_PROVIDER=openrouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
# OPENROUTER_MAX_TOKENS=700

# Optional Anthropic direct mode.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_MAX_TOKENS=1024

# Optional NVIDIA reranker.
# Leave disabled for fastest local-only RAG. Enable only when NVIDIA_API_KEY is set.
USE_NVIDIA_RERANKER=false
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
# Optional full endpoint override, for example a local NIM /v1/ranking URL.
# NVIDIA_RERANK_URL=http://localhost:8000/v1/ranking
# Set true only when debugging reranker failures.
RERANKER_DEBUG=false

# Crawler domain hard-lock (anti-collision + anti-SSRF).
# Comma-separated registrable domains the web crawler is allowed to visit.
# Subdomains are permitted automatically. Off-domain / private-IP start URLs are
# refused. Leave EMPTY to disable the hard-lock (not recommended for production).
ALLOWED_CRAWL_DOMAINS=anthonys.ac.in

SUPABASE_URL=https://your-project-ref.supabase.co

SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

FRONTEND_URL=http://localhost:5173
